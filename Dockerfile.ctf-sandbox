FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN (npm ci --legacy-peer-deps --ignore-scripts || (rm -rf node_modules && npm ci --legacy-peer-deps --ignore-scripts)) \
    && test -x node_modules/.bin/tsc
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN npm run build

FROM node:22-bookworm AS ctf-sandbox

WORKDIR /app
COPY tools/ctf/install-apt-core.sh ./tools/ctf/install-apt-core.sh
RUN bash /app/tools/ctf/install-apt-core.sh
COPY tools/ctf/install-radare2.sh tools/ctf/install-jadx.sh ./tools/ctf/
RUN bash /app/tools/ctf/install-radare2.sh \
    && bash /app/tools/ctf/install-jadx.sh
COPY tools/ctf/install-ghidra.sh tools/ctf/ghidra/DumpDecompiled.java ./tools/ctf/
COPY tools/ctf/deps/ ./tools/ctf/deps/
# Ghidra is ~2GB and never appears in the agent's allowedPrograms allowlist
# (jadx/r2 cover the RE surface the agent can actually invoke); the hosted
# image ships without it to stay under the platform's 3GB upload cap.
ARG INSTALL_GHIDRA=true
RUN if [ "$INSTALL_GHIDRA" = "true" ]; then bash /app/tools/ctf/install-ghidra.sh; fi
COPY tools/ctf/install-python-core.sh tools/ctf/requirements-core.txt tools/ctf/verify-core-tools.sh ./tools/ctf/
RUN bash /app/tools/ctf/install-python-core.sh \
    && bash /app/tools/ctf/verify-core-tools.sh
COPY tools/ctf/install-heavy.sh tools/ctf/requirements-heavy.txt tools/ctf/verify-heavy-tools.sh tools/ctf/capabilities.json ./tools/ctf/
ARG INSTALL_HEAVY=false
RUN if [ "$INSTALL_HEAVY" = "true" ]; then \
      bash /app/tools/ctf/install-heavy.sh \
      && bash /app/tools/ctf/verify-heavy-tools.sh; \
    fi

COPY package.json package-lock.json ./
RUN (npm ci --omit=dev --legacy-peer-deps --ignore-scripts || (rm -rf node_modules && npm ci --omit=dev --legacy-peer-deps --ignore-scripts)) \
    && test -x node_modules/.bin/tsc \
    && npm cache clean --force \
    && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY config ./config

RUN mkdir -p /workspace/input /workspace/work /run/xuanshu \
    && useradd --create-home --uid 10001 sandbox \
    && chown -R sandbox:sandbox /workspace/work /run/xuanshu

USER sandbox
ENV NODE_ENV=production
ENV PATH="/opt/ctf-venv/bin:${PATH}"
ENV XUANSHU_SANDBOX_NETWORK=none
CMD ["node", "dist/cli.js", "sandbox", "--config", "config/container.yaml"]
