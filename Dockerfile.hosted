# TSecBench hosted-mode image: the ctf-sandbox toolchain image + the arena
# driver, bootstrapped by tools/arena/hosted-entrypoint.sh (sandbox executor +
# server + 2 deep lanes + 1 prospector lane, one container). Only the generic
# driver enters the image: no challenge state, no per-challenge tooling, no
# credentials (platform injects BENCHMARK_* and BIGMODEL_API_KEY).
#
# Build on amd64 (the eval platform is amd64; arm64 builds die at ENTRYPOINT
# with exec format error) — see .github/workflows/build-hosted-oci.yml. The
# nogh base below drops ghidra (~2GB, absent from the agent's allowedPrograms
# allowlist so nothing can invoke it) and can be produced either by building
# Dockerfile.ctf-sandbox with INSTALL_GHIDRA=false, or — much faster, no
# toolchain reinstall — by flattening the existing fat image:
#   docker run --user 0 --name flat --entrypoint /bin/sh \
#     localhost/zhulong-xuanshu-ctf-sandbox:latest \
#     -c 'rm -rf /opt/ghidra_*_PUBLIC /opt/ghidra-scripts \
#            /usr/local/bin/analyzeHeadless /usr/local/bin/ghidra-decompile'
#   docker export flat | docker import - zhulong-xuanshu-ctf-sandbox:nogh
# (imported images carry no ENV — everything the runtime needs is re-applied
# below: venv PATH, NODE_ENV, network mode.) A dedicated build stage compiles
# dist from src (the baked dist lags — day-to-day deploys docker-cp into
# containers), and maps/d.ts are stripped to keep source out of the artifact.
#
# SANDBOX_BASE must be declared before the first FROM: an ARG declared inside
# a stage is invisible to subsequent FROM lines on BuildKit (this step only
# ever ran for the first time in CI run 9 and failed with 'base name should
# not be blank').
ARG SANDBOX_BASE=zhulong-xuanshu-ctf-sandbox:nogh
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
# Same npm-12 upgrade + race hardening as Dockerfile.ctf-sandbox: bundled
# npm 10.9.x crashes 'Exit handler never called!' near-deterministically on
# GitHub runner networks (runs 6-7: 5/5).
RUN (npm install -g npm@12.2.0 --no-audit --no-fund \
     || npm install -g npm@12.2.0 --no-audit --no-fund) \
    && npm --version
RUN for i in 1 2 3; do \
      npm ci --legacy-peer-deps --ignore-scripts --no-audit --no-fund \
             --fetch-retries=5 --maxsockets=3 && break; \
      echo "npm ci attempt $i failed; wiping tree and retrying"; \
      rm -rf node_modules; \
    done \
    && test -x node_modules/.bin/tsc
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN npm run build

FROM ${SANDBOX_BASE}
USER root
WORKDIR /app
COPY tools/arena/tsec.mjs tools/arena/hosted-entrypoint.sh tools/arena/rogue-ldaps.py tools/arena/captcha-ocr.py tools/arena/cve-quickref.md ./tools/arena/
# Headless Chromium (R8, bctf top-6 post-mortem): the #2 efficiency runner's
# real-browser discipline for JS-rendered/login-gated pages — driven via
# run_command (chromium --headless --dump-dom / --screenshot) since the
# heavyweight web-reasoning browser mode is not enabled for CTF runs.
# tesseract-ocr (R22): the web playbook already tells the agent to OCR with
# tesseract, but it was never in the image — 30661's rotating-captcha
# challenge burned its whole budget on manual glyph guessing because of it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium fonts-liberation fonts-dejavu-core iproute2 tesseract-ocr \
    && rm -rf /var/lib/apt/lists/* \
    && chromium --version && tesseract --version | head -1
# Generic web-attack knowledge base (R8, bctf top-6 post-mortem: the #2 agent's
# core capability was "fingerprint the product, open the matching CVE template,
# never fuzz a known product from scratch"). nuclei binary + curated template
# subsets + SecLists wordlists land in /opt/kb; the task text points agents at
# tools/arena/cve-quickref.md. All failures fail the build loudly (CI red)
# rather than shipping a silently missing capability.
RUN NUCLEI_VER=3.4.5 \
    && curl -fsSL --retry 5 -o /tmp/nuclei.zip \
      "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VER}/nuclei_${NUCLEI_VER}_linux_amd64.zip" \
    && unzip -j -o /tmp/nuclei.zip '*nuclei' -d /usr/local/bin/ \
    && rm /tmp/nuclei.zip \
    && nuclei -version 2>/dev/null | head -1 \
    && mkdir -p /opt/kb \
    && git clone --depth 1 https://github.com/projectdiscovery/nuclei-templates /tmp/nct \
    && mkdir -p /opt/kb/nuclei-templates/http \
    && cp -r /tmp/nct/http/technologies /tmp/nct/http/cves /tmp/nct/http/exposures \
             /tmp/nct/http/takeovers /opt/kb/nuclei-templates/http/ 2>/dev/null || true \
    && cp /tmp/nct/README.md /opt/kb/nuclei-templates/ 2>/dev/null || true \
    && rm -rf /tmp/nct \
    && git clone --depth 1 https://github.com/danielmiessler/SecLists /tmp/sl \
    && mkdir -p /opt/kb/seclists/Discovery /opt/kb/seclists/Usernames /opt/kb/seclists/Passwords \
    && cp -r /tmp/sl/Discovery/Web-Content /opt/kb/seclists/Discovery/ \
    && cp /tmp/sl/Usernames/*.txt /opt/kb/seclists/Usernames/ 2>/dev/null || true \
    && cp /tmp/sl/Passwords/*.txt /opt/kb/seclists/Passwords/ 2>/dev/null || true \
    && rm -rf /tmp/sl \
    && cp tools/arena/cve-quickref.md /opt/kb/cve-quickref.md \
    && du -sh /opt/kb \
    && test -x /usr/local/bin/nuclei \
    && test -d /opt/kb/nuclei-templates/http/cves \
    && test -f /opt/kb/seclists/Discovery/Web-Content/common.txt
RUN rm -rf /app/dist
COPY --from=build /app/dist ./dist
RUN chmod +x /app/tools/arena/hosted-entrypoint.sh \
    && find dist -name '*.map' -delete \
    && find dist -name '*.d.ts' -delete \
    && mkdir -p /workspace/input /workspace/work /data/runs /run/xuanshu /app/workspace
ENV NODE_ENV=production
ENV PATH="/opt/ctf-venv/bin:${PATH}"
ENV XUANSHU_SANDBOX_NETWORK=external
ENTRYPOINT ["/app/tools/arena/hosted-entrypoint.sh"]
