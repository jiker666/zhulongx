{
  "name": "zhulong-xuanshu",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "面向网络安全实战的自主决策智能体",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiker666/zhulong-xuanshu.git"
  },
  "homepage": "https://github.com/jiker666/zhulong-xuanshu#readme",
  "bugs": {
    "url": "https://github.com/jiker666/zhulong-xuanshu/issues"
  },
  "keywords": ["agent", "cybersecurity", "ctf", "sandbox", "typescript"],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "xuan-shu": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "sandbox": "tsx src/cli.ts sandbox",
    "sandbox-health": "tsx src/cli.ts sandbox-health",
    "serve": "tsx src/cli.ts serve",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "typebox": "1.3.9",
    "yaml": "2.9.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/yauzl": "2.10.3",
    "tsx": "4.22.1",
