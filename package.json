{
  "name": "zhulong-xuanshu",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "具备自主规划、执行、验证与审计能力的通用网络安全智能体运行时",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiker666/zhulong-xuanshu.git"
  },
  "homepage": "https://github.com/jiker666/zhulong-xuanshu#readme",
  "bugs": {
    "url": "https://github.com/jiker666/zhulong-xuanshu/issues"
  },
  "keywords": [
    "agent",
    "cybersecurity",
    "security-automation",
    "policy-engine",
    "sandbox",
    "typescript"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "xuan-shu": "dist/cli.js"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx src/cli.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "doctor": "tsx src/cli.ts doctor",
    "sandbox": "tsx src/cli.ts sandbox",
    "sandbox-health": "tsx src/cli.ts sandbox-health",
    "serve": "tsx src/cli.ts serve",
    "start": "node dist/cli.js",
    "test": "vitest run test frontend/src/features/decision-stream/projection.test.ts frontend/src/features/evidence-graph/projection.test.ts frontend/src/features/realtime/merge.test.ts frontend/src/features/policy/projection.test.ts frontend/src/features/decision-observatory/projection.test.ts --no-file-parallelism",
    "test:browser": "vitest run test/browser-runtime.test.ts test/browser-live.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.268",
    "@anthropic-ai/sdk": "^0.125.0",
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "domhandler": "^6.0.1",
    "htmlparser2": "^12.0.0",
    "playwright": "^1.62.1",
    "typebox": "1.3.9",
    "typescript": "5.9.3",
    "undici": "7.29.0",
    "yaml": "2.9.0",
    "yauzl": "3.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22.19.19",
    "@types/yauzl": "2.10.3",
    "eslint": "^10.8.0",
    "tsx": "4.22.1",
    "typescript-eslint": "^8.66.0",
    "vitest": "4.1.9"
  }
}
