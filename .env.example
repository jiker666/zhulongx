# Model credentials are read by name only and never persisted in run artifacts.
# Anthropic-protocol endpoint credential (see config/default.yaml model.apiKeyEnv).
XUANSHU_MODEL_API_KEY=

# Control-plane bearer token. Copy this file to .env and set a value to keep
# the token stable across restarts: Compose and the start scripts read .env,
# and the browser remembers the token (localStorage) instead of re-entering it.
XUANSHU_SERVER_TOKEN=

# Optional model gateway proxy for operator-managed deployments.
XUANSHU_MODEL_PROXY=

# Set to true only when the operator intentionally enables the extended sandbox image.
XUANSHU_INSTALL_HEAVY_CTF_TOOLS=false
