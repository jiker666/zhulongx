# =========================================================
# 烛龙·玄枢 ZHULONG-X 配置
# =========================================================
APP_NAME=烛龙·玄枢 ZHULONG-X
APP_TAGLINE=烛照隐微，枢决攻防
APP_ENV=dev
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=sqlite:///./data/cyberpilot.db
UPLOAD_DIR=./backend/app/storage/uploads
REPORT_DIR=./backend/app/storage/reports
CTF_DEMO_DIR=./examples/ctf_demo
# Keep untrusted run workspaces outside the source checkout.
CTF_RUN_DIR=/tmp/zhulongx/ctf_runs

# =========================================================
# v8 Hard Mode — 困难题增强
# =========================================================
CTF_MAX_ROUNDS=0           # 0=无限，仅受 max_time_sec 限制
CTF_MAX_TIME_SEC=1800     # 30 分钟
CTF_SANDBOX_TIMEOUT=60
CTF_SANDBOX_MAX_OUTPUT=80000
CTF_HARD_MODE=true
CTF_VERIFY_CONTINUE_ON_NO_FLAG=true

# =========================================================
# ScopeGuard / 授权范围
# =========================================================
COMPETITION_MODE=false
SCOPE_CIDRS=
SCOPE_DOMAINS=
SCOPE_PORTS=
SCOPE_ALLOW_LOCALHOST=false
SCOPE_ALLOW_PRIVATE_IPS=false
MAX_REQUESTS_PER_TASK=120
MAX_REQUESTS_PER_TARGET=40
DEFAULT_HTTP_TIMEOUT=10
MAX_CONCURRENT_TASKS=3
MAX_CONCURRENT_TASKS_PER_CHALLENGE=2
DEV_ALLOW_PRIVATE_TARGETS=false

# =========================================================
# LLM 配置 — 晚晴网关 (Wanqing) GLM-5.2
# ⚠️ 安全说明：
#   方式一（推荐）：设置环境变量 WQ_API_KEY，自动覆盖所有 lane
#     export WQ_API_KEY="your_api_key_here"
#   方式二：直接在 .env 文件中填入各 lane 的 API_KEY
#     （确保 .env 已被 .gitignore 排除，不会提交到仓库）
#   代码中所有 key 经 mask_secret 脱敏，永不出现在日志/报告/前端
# =========================================================
LLM_ENABLED=true
LLM_PROVIDER=wanqing
LLM_BASE_URL=https://wanqing-api.corp.kuaishou.com/api/gateway/v1
LLM_API_KEY=replace_me
LLM_MODEL=ep-yba64y-1782808149582099879
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.15
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# =========================================================
# v6+ 成本感知模型路由
# =========================================================
LLM_ROUTER_ENABLED=true
LLM_BUDGET_PER_TASK_USD=1.00
LLM_BUDGET_DAILY_USD=10.00
LLM_DEFAULT_MAX_CONTEXT_CHARS=12000
LLM_COMPRESS_THRESHOLD_CHARS=8000

# Cheap Lane — 晚晴网关（降低 max_tokens 节省成本）
LLM_CHEAP_PROVIDER=wanqing
LLM_CHEAP_BASE_URL=https://wanqing-api.corp.kuaishou.com/api/gateway/v1
LLM_CHEAP_MODEL=ep-yba64y-1782808149582099879
LLM_CHEAP_API_KEY=replace_me
LLM_CHEAP_MAX_TOKENS=2048
LLM_CHEAP_TEMPERATURE=0.2

# Expert Lane — 晚晴网关 GLM-5.2（全量 token 配额）
LLM_EXPERT_PROVIDER=wanqing
LLM_EXPERT_BASE_URL=https://wanqing-api.corp.kuaishou.com/api/gateway/v1
LLM_EXPERT_MODEL=ep-yba64y-1782808149582099879
LLM_EXPERT_API_KEY=replace_me
LLM_EXPERT_MAX_TOKENS=8192
LLM_EXPERT_TEMPERATURE=0.15

# Fallback Lane — 同晚晴网关
LLM_FALLBACK_PROVIDER=wanqing
LLM_FALLBACK_BASE_URL=https://wanqing-api.corp.kuaishou.com/api/gateway/v1
LLM_FALLBACK_MODEL=ep-yba64y-1782808149582099879
LLM_FALLBACK_API_KEY=replace_me

# WQ 统一 API Key — 设置后自动覆盖上述所有 lane 的 API_KEY
# 推荐方式：export WQ_API_KEY="your_key" 后启动
WQ_API_KEY=

# =========================================================
# CTF 题目专用配置
# =========================================================
BLIND_SOLVE_MODE=true
DISABLE_RAG_FOR_SOLVE=true
DISABLE_HISTORY_MATCHING=true
DISABLE_INTERNET_SEARCH=true
MCP_ONLY_SOLVE=true
ALLOW_LLM_REASONING=true
ALLOW_LLM_PUBLIC_MEMORY_GUESS=false
SOLVE_ALLOWED_ROOTS=
SOLVE_DENIED_ROOTS=
SOLVE_CASE_ID=


# Legacy Claude Code bridge. Compatibility use is explicit; no silent fallback.
CC_RUNTIME_ENABLED=false
CC_RUNTIME_REQUIRE_EXTERNAL=false
CC_RUNTIME_FALLBACK_INTERNAL=false
# 可选：指定系统 claude 命令，例如 /usr/local/bin/claude
CC_RUNTIME_BIN=
# 可选：高级模板，例如 claude -p "$(cat {prompt_file_q})" 不适合 shlex；推荐写一个 wrapper 脚本再填 CC_RUNTIME_BIN
CC_RUNTIME_COMMAND_TEMPLATE=
CC_RUNTIME_VENDOR_DIR=./vendor/claude-code
CC_RUNTIME_TIMEOUT=600
CC_RUNTIME_MAX_OUTPUT_CHARS=120000
CC_RUNTIME_SKIP_PERMISSIONS=false

# Agent Engine v2 production sandbox. The image must already exist locally;
# runtime execution uses --pull=never.
AGENT_SANDBOX_RUNTIME=podman
AGENT_SANDBOX_IMAGE=python:3.11-slim
