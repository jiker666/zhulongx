# API key for the OpenAI-compatible endpoint configured in config/default.yaml.
# Keep the real value in the shell environment or an ignored .env file.
OPENAI_API_KEY=

# Baidu Agent AWD / TSecBench model gateway key. The TSec hosted image reads
# this runtime-only value through config/tsec-hosted.yaml.
BAIDU_API_KEY=

# Wanqing API Key for wanqing.internal / wanqing-api.corp.kuaishou.com endpoints.
# Used by config/wanqing.yaml and config/nss-wanqing.yaml (model.apiKeyEnv: WQ_API_KEY).
WQ_API_KEY=

# Office-network Wanqing token for config/nss-wanqing.yaml. The endpoint ID is
# kept in that config; the token must remain in the shell or ignored .env.
TAKUMI_BU_TOKEN=

# Optional bearer token for the REST API. Set this for any non-local deployment.
XUANSHU_SERVER_TOKEN=

# NSSCTF Agent Arena token. Keep this out of git; the CLI reads .env automatically.
NSSCTF_AGENT_TOKEN=

# DASC Agent API AccessKey for config/dasctf-wanqing.yaml. Keep it out of git.
DASCTF_ACCESS_KEY=

# Optional local CyBench question bank root. The configured list files are
# task_list_crypto.txt and task_list_misc.txt.
XUANSHU_QUESTION_BANK_ROOT=

# Optional: set true to add angr/qiling/frida/torch/transformers to the CTF sandbox image.
XUANSHU_INSTALL_HEAVY_CTF_TOOLS=false
