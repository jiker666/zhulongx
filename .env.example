# =========================================================
# 烛龙·玄枢 ZHULONG-X 配置
# =========================================================
APP_NAME=烛龙·玄枢 ZHULONG-X
APP_TAGLINE=烛照隐微，枢决攻防
APP_ENV=dev
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=sqlite:///./data/cyberpilot.db
UPLOAD_DIR=./backend/app/storage/uploads
REPORT_DIR=./backend/app/storage/reports
CTF_DEMO_DIR=./examples/ctf_demo
CTF_RUN_DIR=./backend/data/ctf_runs
CTF_MAX_ROUNDS=8
CTF_SANDBOX_TIMEOUT=15
CTF_SANDBOX_MAX_OUTPUT=20000

# =========================================================
# ScopeGuard / 授权范围（关键安全配置）
# =========================================================
# 默认禁止公网访问；CTF 远程题必须 authorized=true + allow_network=true
COMPETITION_MODE=false
SCOPE_CIDRS=
SCOPE_DOMAINS=
SCOPE_PORTS=
SCOPE_ALLOW_LOCALHOST=false
SCOPE_ALLOW_PRIVATE_IPS=false
MAX_REQUESTS_PER_TASK=120
MAX_REQUESTS_PER_TARGET=40
DEFAULT_HTTP_TIMEOUT=10
MAX_CONCURRENT_TASKS=3
MAX_CONCURRENT_TASKS_PER_CHALLENGE=2
DEV_ALLOW_PRIVATE_TARGETS=false

# =========================================================
# LLM 配置 (烛龙·玄枢 v5)
# =========================================================
# 是否启用真实 LLM；false 时自动进入 mock 模式（无需 key 即可演示）
LLM_ENABLED=false

# LLM Provider 标识：openai_compatible | deepseek | qwen | glm | moonshot | oneapi | codex | mock
LLM_PROVIDER=openai_compatible

# OpenAI-compatible API 的 base_url
# 示例:
#   Ollama:     http://localhost:11434/v1
#   OpenAI:     https://api.openai.com/v1
#   DeepSeek:   https://api.deepseek.com/v1
#   OneAPI:     http://your-oneapi-host/v1
#   LiteLLM:    http://localhost:8080/v1
LLM_BASE_URL=http://localhost:11434/v1

# API Key (必须替换, 不要提交真实密钥)
# ⚠️ 真实 key 永不出现在日志/报告/前端，会被 mask_secret 脱敏
LLM_API_KEY=replace_me

# 模型名称 (按实际部署填写)
LLM_MODEL=qwen2.5-coder

# LLM 请求超时 (秒)
LLM_TIMEOUT=60

# LLM 最大重试次数 (指数退避)
LLM_MAX_RETRIES=2

# 最大 token 数
LLM_MAX_TOKENS=4096

# 温度 (0.0-1.0)
LLM_TEMPERATURE=0.2

# =========================================================
# v6 成本感知模型路由 (Cost-aware Model Router)
# =========================================================
# 是否启用模型路由（默认 true；关闭时退回单一 LLM_ADAPTER）
LLM_ROUTER_ENABLED=true

# 预算控制（USD）
LLM_BUDGET_PER_TASK_USD=0.05
LLM_BUDGET_DAILY_USD=1.00

# 上下文压缩阈值
LLM_DEFAULT_MAX_CONTEXT_CHARS=12000
LLM_COMPRESS_THRESHOLD_CHARS=8000

# Cheap Lane — 日常分类 / 计划 / 普通脚本生成 / 短错误修复
# 推荐：DeepSeek-V4-Flash / Qwen-Coder / GLM-4-Flash
LLM_CHEAP_PROVIDER=deepseek
LLM_CHEAP_BASE_URL=https://api.deepseek.com/v1
LLM_CHEAP_MODEL=deepseek-v4-flash
LLM_CHEAP_API_KEY=replace_me
LLM_CHEAP_MAX_TOKENS=1800
LLM_CHEAP_TEMPERATURE=0.2

# Expert Lane — 连续失败 / 复杂工程 / 长上下文 / 循环时升级
# 推荐：GLM-5.2 / DeepSeek-V4-Pro / Qwen-Max
LLM_EXPERT_PROVIDER=glm
LLM_EXPERT_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_EXPERT_MODEL=glm-5.2
LLM_EXPERT_API_KEY=replace_me
LLM_EXPERT_MAX_TOKENS=4096
LLM_EXPERT_TEMPERATURE=0.2

# Fallback Lane — 可选备用模型
LLM_FALLBACK_PROVIDER=qwen
LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_MODEL=qwen-coder-plus
LLM_FALLBACK_API_KEY=replace_me

# =========================================================
# CTF 题目专用配置
# =========================================================
# 盲解模式（不依赖历史匹配）
BLIND_SOLVE_MODE=true
DISABLE_RAG_FOR_SOLVE=true
DISABLE_HISTORY_MATCHING=true
DISABLE_INTERNET_SEARCH=true
MCP_ONLY_SOLVE=true
ALLOW_LLM_REASONING=true
ALLOW_LLM_PUBLIC_MEMORY_GUESS=false
SOLVE_ALLOWED_ROOTS=
SOLVE_DENIED_ROOTS=
SOLVE_CASE_ID=
